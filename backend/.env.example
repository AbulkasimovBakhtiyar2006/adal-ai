# Copy to backend/.env. Never commit keys or ADC/service-account credentials.
# Select models available to your accounts. Empty model names disable readiness.
GENERATOR_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional override for speech-to-text; otherwise GEMINI_MODEL is used.
AUDIO_MODEL=
# Blank critic key reuses DEEPSEEK_API_KEY only for the official DeepSeek URL.
CRITIC_API_KEY=
CRITIC_MODEL=
CRITIC_BASE_URL=https://api.deepseek.com

# Check Grounding uses Google Cloud ADC, NOT the Gemini API key.
GOOGLE_CLOUD_PROJECT=
# Prefer gcloud auth application-default login for local development.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json

CORPUS_PATH=data/knowledge.jsonl
LIBRARY_DIR=data/library
RUNTIME_DIR=data/runtime
SOURCE_MAX_AGE_DAYS=30
# Experimental thresholds. Calibrate on separately reviewed RU and KK examples.
GROUNDING_SUPPORT_THRESHOLD=0.95
GROUNDING_CLAIM_THRESHOLD=0.95
GROUNDING_CITATION_THRESHOLD=0.8

# Optional for localhost; required by this app when binding to a public interface.
BACKEND_API_KEY=
# Separate admin token. Without it, /admin/api permits loopback connections only.
ADMIN_API_KEY=
# Public browser chat without exposing BACKEND_API_KEY; requires ADMIN_API_KEY.
PUBLIC_WEB_ENABLED=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
HOST=127.0.0.1
PORT=8000
PROVIDER_TIMEOUT_SECONDS=25
REQUEST_TIMEOUT_SECONDS=100
MAX_CONCURRENT_REQUESTS=4
